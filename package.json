{
  "name": "flash-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n fn,scorer,vite -c cyan,yellow,magenta \"npm run dev:functions\" \"npm run dev:scorer\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:functions": "npx supabase functions serve",
    "dev:scorer": "node server/run.mjs",
    "scorer": "node server/run.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:model": "vitest run src/app/lib/acoustic/session.integration.test.ts",
    "model:fetch": "node scripts/fetch-acoustic-model.mjs",
    "stats:native": "node scripts/gen-native-stats.mjs",
    "db:phones": "node scripts/gen-phrase-phones.mjs",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "node scripts/reset-db.mjs",
    "db:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.2",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "onnxruntime-web": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.0",
    "supabase": "^2.93.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
