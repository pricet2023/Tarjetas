# ---------------------------------------------------------------------------
# Local development. `npm run db:start` prints these values.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>

# Used by scripts/gen-types.mjs — local by default.
SUPABASE_DEV_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# The pronunciation scorer (plan §19, infra/README.md).
#
# Unset VITE_SCORER_URL means "no scorer": every device runs the model itself,
# which is exactly the behaviour before §19. Set, it becomes the fallback for
# devices that cannot hold 197 MB resident — and the *preference* for ones
# reporting <= 4 GB of memory.
#
# Relative in dev, so vite.config.ts's proxy sends it to the local service and
# no CORS is involved. In production this is the Cloudflare Tunnel hostname,
# set in Vercel's project environment rather than here.
# ---------------------------------------------------------------------------
VITE_SCORER_URL=/api/scorer

# Server side. Not read by the browser — no VITE_ prefix, so Vite will not
# inline them into the bundle. `npm run dev:scorer` reads this file directly.
SCORER_PORT=8787
SCORER_HOST=127.0.0.1

# Local development only. The scorer refuses to start without *some* way to
# verify tokens, and this is the way to say "don't". Never set it on the box.
SCORER_ALLOW_ANONYMOUS=1

# Production auth, one of these two depending on how your project signs JWTs:
#   - older projects sign HS256 with a shared secret -> SUPABASE_JWT_SECRET
#   - newer ones use asymmetric keys                 -> SUPABASE_URL alone
# Both live in the box's systemd EnvironmentFile, never in the repo. The JWT
# secret is as dangerous as the service role key: it mints valid sessions.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<Settings -> API -> JWT Secret>
# SCORER_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# ---------------------------------------------------------------------------
# Production is NOT configured here.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY for the deployed app live in
# Vercel's project environment variables, which the deploy workflow fetches
# with `vercel pull`. Keeping one copy avoids the two drifting apart.
#
# The anon key is public by design — it ships inside the JavaScript bundle and
# is worth exactly what RLS says it is. The key that must never be committed or
# put in Vercel is the *service role* key, which bypasses RLS entirely.
#
# See docs/deploying.md.
# ---------------------------------------------------------------------------
